# Copy to .env.local and fill in. .env.local is gitignored.
# With none of these set the app runs fully offline in simulated mode.

# ── Solana ────────────────────────────────────────────────────
# Your own RPC endpoint. This URL contains an API key — keep it out of git.
VITE_SOLANA_RPC=
VITE_SOLANA_CLUSTER=devnet

# Printed by `anchor deploy` (see onchain/README.md).
VITE_PAFA_PROGRAM_ID=

# Treasury pubkey created by scripts/setup-devnet.ts.
VITE_PAFA_TREASURY=

# xStock mints for this cluster, as JSON. setup-devnet.ts prints this line.
# e.g. {"NKEx":"...","AAPLx":"..."}
VITE_XSTOCK_MINTS=

# Settlement service that signs record_purchase as the treasury.
# Without it, purchases are priced on-chain but not settled.
VITE_PAFA_API=http://localhost:8787

# ── Privy ─────────────────────────────────────────────────────
# From dashboard.privy.io. Unset -> local mock auth.
VITE_PRIVY_APP_ID=

# ── Escape hatch ──────────────────────────────────────────────
# Force the simulated adapter even when everything above is set.
VITE_FORCE_SIMULATED=false
